rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /syncs/{syncCode} {
      allow read, write: if true;
    }
    match /junior_matches/{matchId} {
      allow read, write: if true;
    }
    match /live_stats/{statsId} {
      allow read, write: if true;
    }
  }
}
